    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "find-up": "^8.0.0",
    "hono": "^4.13.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "wxt": "^0.21.3"
